# PolicyPilot Environment Variables Template
# Copy this file to .env.local and populate the values.
# NEVER commit .env.local or expose secrets to the client.

# Supabase Public Configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Approved business login emails (comma-separated). Required in production.
APP_ALLOWED_EMAILS=

# Supabase Server-Side Secret Key (Server-only, do not expose to browser)
SUPABASE_SERVICE_ROLE_KEY=

# Internal Automation Secret Key (For cron triggers to /api/automation/daily-summary)
AUTOMATION_SECRET_KEY=

# Email Provider Configuration (Optional: for daily summary email delivery)
RESEND_API_KEY=
